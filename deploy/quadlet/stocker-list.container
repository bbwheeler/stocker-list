[Unit]
# Only network ordering: the broker is remote and the producer connects lazily
# at the first publish. If a local RabbitMQ container is ever added, order
# against it here (After=/Wants= on that unit).
After=network-online.target

[Container]
Image=git.wheeli.ca/brian/stocker-list:latest
EnvironmentFile=%h/.config/stocker-list/.env.podman
AutoUpdate=registry

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=default.target